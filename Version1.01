local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local hrp = nil

local function updateHRP()
    if player.Character then
        hrp = player.Character:FindFirstChild("HumanoidRootPart")
    end
end
player.CharacterAdded:Connect(function()
    task.wait(1)
    updateHRP()
end)
updateHRP()

local speed = 20
local farmEnabled = false
local farmLoop = nil
local collected = {}

local function getNearestCoin()
    if not hrp then return nil end
    local pos = hrp.Position
    local best, dist = nil, 9e9
    for _, map in Workspace:GetChildren() do
        local folder = map:FindFirstChild("CoinContainer")
        if folder then
            for _, coin in folder:GetChildren() do
                if coin.Name == "Coin_Server" and coin:FindFirstChild("CoinVisual") and not collected[coin] then
                    local d = (pos - coin.Position).Magnitude
                    if d < 250 and d < dist and d > 5 then
                        dist = d
                        best = coin
                    end
                end
            end
        end
    end
    return best
end


local function startFarming()
    while farmEnabled do
        if not hrp or not player.Character or (player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health <= 0) then
            task.wait(0.8)
            continue
        end
        local coin = getNearestCoin()
        if coin then
            collected[coin] = true
            local goal = CFrame.new(coin.Position + Vector3.new(0, 3, 0))
            local time = math.max((hrp.Position - coin.Position).Magnitude / speed, 0.03)
            local tween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = goal})
            tween:Play()

          
            local coinStillValid = true
            while tween.PlaybackState == Enum.PlaybackState.Playing and coinStillValid do
                if not coin.Parent or not coin:FindFirstChild("TouchInterest") then
                    coinStillValid = false
                    tween:Cancel()
                end
                task.wait()
            end
   
        else
            task.wait(0.08)
        end
    end
end

local screenGui = Instance.new("ScreenGui")
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 240)
frame.Position = UDim2.new(0.5, -130, 0.4, -120)
frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
frame.BorderSizePixel = 1
frame.BorderColor3 = Color3.fromRGB(80, 80, 80)
frame.Parent = screenGui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
title.BorderSizePixel = 0
title.Text = "MM2 Script"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.ArialBold
title.TextSize = 18
title.Parent = frame

local minButton = Instance.new("TextButton")
minButton.Size = UDim2.new(0, 28, 0, 28)
minButton.Position = UDim2.new(1, -32, 0, 1)
minButton.BackgroundTransparency = 0.8
minButton.Text = "–"
minButton.TextColor3 = Color3.new(1,1,1)
minButton.Font = Enum.Font.ArialBold
minButton.TextSize = 24
minButton.Parent = title

local miniSquare = Instance.new("Frame")
miniSquare.Size = UDim2.new(0, 60, 0, 60)
miniSquare.Position = UDim2.new(0.02, 10, 0.5, -30)
miniSquare.BackgroundColor3 = Color3.fromRGB(0, 180, 60)
miniSquare.BorderSizePixel = 2
miniSquare.BorderColor3 = Color3.new(1,1,1)
miniSquare.Visible = false
miniSquare.Parent = screenGui

local miniText = Instance.new("TextLabel")
miniText.Size = UDim2.new(1,0,1,0)
miniText.BackgroundTransparency = 1
miniText.Text = "MM2"
miniText.TextColor3 = Color3.new(1,1,1)
miniText.Font = Enum.Font.ArialBold
miniText.TextSize = 20
miniText.Parent = miniSquare

local dragging = false
local dragStart, startPos
title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

minButton.MouseButton1Click:Connect(function()
    frame.Visible = false
    miniSquare.Visible = true
end)
miniSquare.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        frame.Visible = true
        miniSquare.Visible = false
    end
end)

local speedLabel = Instance.new("TextLabel")
speedLabel.Size = UDim2.new(0, 60, 0, 25)
speedLabel.Position = UDim2.new(0, 15, 0, 40)
speedLabel.BackgroundTransparency = 1
speedLabel.Text = "Speed:"
speedLabel.TextColor3 = Color3.new(1, 1, 1)
speedLabel.Font = Enum.Font.Arial
speedLabel.TextSize = 16
speedLabel.Parent = frame

local speedBox = Instance.new("TextBox")
speedBox.Size = UDim2.new(0, 70, 0, 25)
speedBox.Position = UDim2.new(0, 80, 0, 40)
speedBox.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
speedBox.BorderColor3 = Color3.fromRGB(90, 90, 90)
speedBox.Text = tostring(speed)
speedBox.TextColor3 = Color3.new(1, 1, 1)
speedBox.Font = Enum.Font.Arial
speedBox.TextSize = 16
speedBox.Parent = frame

speedBox.FocusLost:Connect(function()
    local num = tonumber(speedBox.Text)
    if num and num >= 1 and num <= 50 then
        speed = num
    else
        speedBox.Text = tostring(speed)
    end
end)

local farmButton = Instance.new("TextButton")
farmButton.Size = UDim2.new(0, 200, 0, 40)
farmButton.Position = UDim2.new(0, 20, 0, 75)
farmButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
farmButton.BorderColor3 = Color3.fromRGB(100, 0, 0)
farmButton.Text = "FARM OFF"
farmButton.TextColor3 = Color3.new(1, 1, 1)
farmButton.Font = Enum.Font.ArialBold
farmButton.TextSize = 20
farmButton.Parent = frame

farmButton.MouseButton1Click:Connect(function()
    farmEnabled = not farmEnabled
    if farmEnabled then
        farmButton.Text = "FARM ON"
        farmButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        farmButton.BorderColor3 = Color3.fromRGB(0, 100, 0)
        collected = {}
        if farmLoop then task.cancel(farmLoop) end
        farmLoop = task.spawn(startFarming)
    else
        farmButton.Text = "FARM OFF"
        farmButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
        farmButton.BorderColor3 = Color3.fromRGB(100, 0, 0)
        if farmLoop then task.cancel(farmLoop) end
    end
end)
